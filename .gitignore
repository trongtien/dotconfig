# Whitelist: bỏ qua tất cả, chỉ đưa lên những gì liệt kê bên dưới.
# (~/.config chứa cả dữ liệu trình duyệt, cookie, cache… không được đưa lên)
/*

!/.gitignore
!/README.md
!/install.sh

# File ngoài ~/.config (install.sh symlink về $HOME / copy vào /etc)
!/home/
!/etc/

# Ứng dụng
!/nvim/
!/kitty/
!/tmux/
!/i3/
!/i3status/
!/hypr/
!/waybar/
!/wofi/
!/fcitx5/
!/Thunar/
!/xfce4/
!/personal/
!/brave-flags.conf
!/mimeapps.list

# Rác / backup / cache bên trong các thư mục trên
*.bak
*.bak-*
/personal/nvim-lazy-backup/
/fcitx5/conf/cached_layouts
