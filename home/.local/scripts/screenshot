#!/usr/bin/env bash
# Chụp màn hình bằng scrot → ~/Pictures/Screenshots + copy vào clipboard.
#   screenshot            mở menu rofi để chọn kiểu chụp
#   screenshot <kiểu>     chụp luôn: region | full | window | delay
set -u

DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"
FILE="$DIR/$(date +%F_%H-%M-%S).png"

shoot() {
    if scrot "$@" "$FILE"; then
        xclip -selection clipboard -t image/png -i "$FILE"
        notify-send -i "$FILE" "Screenshot taken" "$(basename "$FILE") (copied to clipboard)"
    fi
}

mode="${1:-}"
if [[ -z "$mode" ]]; then
    choice=$(printf '%s\n' \
        "Region" \
        "Full screen" \
        "Active window" \
        "Full screen in 3s" \
        "Open folder" |
        rofi -dmenu -i -p "Screenshot") || exit 0
    case "$choice" in
        "Region")            mode=region ;;
        "Full screen")       mode=full ;;
        "Active window")     mode=window ;;
        "Full screen in 3s") mode=delay ;;
        "Open folder")       exec xdg-open "$DIR" ;;
        *) exit 0 ;;
    esac
    sleep 0.3   # đợi rofi đóng hẳn để không lọt vào ảnh
fi

case "$mode" in
    region) shoot -s -f ;;
    full)   shoot ;;
    window) shoot -u ;;
    delay)  shoot -d 3 -c ;;
    *) echo "Dùng: screenshot [region|full|window|delay]" >&2; exit 1 ;;
esac
